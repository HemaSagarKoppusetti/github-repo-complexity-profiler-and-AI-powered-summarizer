# GitHub Repo Complexity Profiler Configuration

# LLM Provider Configuration (OpenRouter)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PROVIDER=openrouter

# Backend Environment & Database
ENVIRONMENT=development
DEBUG=false
DATA_DIR=data
DATABASE_URL=sqlite:///data/profiler.db

# Security & CORS (comma-separated origins)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Limits & Safeguards
MAX_REPO_SIZE_MB=300
CLONE_TIMEOUT_SECONDS=180
MAX_PYTHON_FILES=2000
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_HOURS=24
